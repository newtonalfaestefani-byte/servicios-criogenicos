<Window Width="800"
        Height="450"
        MinWidth="800"
        MinHeight="450"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Multiservicios_Criogenicos.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Multiservicios_Criogenicos.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Multiservicios Criogenicos">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

        <Grid ColumnDefinitions="*,*">
            <Border Grid.Column="0">
                <Image Source="/Assets/fondologin.jpg" Stretch="UniformToFill" />
            </Border>
            <Border Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">    
                    <TextBlock Text="Iniciar Sesión"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="40"
                           Foreground="#162442"/>
                    <TextBlock Text="Bienvenido al Sistema de&#x0A;MULCRIOMET"
                           TextAlignment="Center"
                           FontWeight="500"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           Foreground="#162442"/>
                    <TextBox Width="330"
                             Height="45"
                             Margin="0,20,0,10"
                             PlaceholderText="Usuario o Correo"
                             CornerRadius="10"
                             BorderBrush="LightGray"
                             VerticalContentAlignment="Center"
                             FontSize="19"
                             BorderThickness="2"
                             Text="{Binding Usuario, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </Grid>

</Window>
